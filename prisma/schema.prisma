// Schema Criafy — usuários, assinaturas, auditoria
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  phone          String?
  passwordHash   String
  role           String    @default("user") // user | admin
  emailVerified  DateTime?
  forcePwdReset  Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  subscription    Subscription?
  purchaseIntents PurchaseIntent[]
  sessions        Session[]
  auditLogs       AuditLog[]      @relation("actor")

  @@index([email])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Assinatura / acesso do usuário
model Subscription {
  id                    String    @id @default(cuid())
  userId                String    @unique
  plan                  String    // monthly | lifetime
  status                String    @default("registered_without_payment")
  // Estados: registered_without_payment, payment_pending, active_monthly,
  // active_lifetime, expired, suspended, canceled, refunded, chargeback
  startedAt             DateTime?
  expiresAt             DateTime?
  applyfyTransactionId  String?
  lastPaymentAt         DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Intenção de compra registrada quando o usuário clica em um plano
model PurchaseIntent {
  id         String   @id @default(cuid())
  userId     String
  plan       String   // monthly | lifetime
  checkoutUrl String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Log de auditoria pra ações administrativas
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String   // ex: user.suspend, subscription.extend, plan.change
  targetId  String?  // id do usuário/subscription/etc afetado
  metadata  Json?
  createdAt DateTime @default(now())

  actor User @relation("actor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([createdAt])
}
